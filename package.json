{
  "name": "@omdsh-plugins/omdsh-plughub",
  "description": "The omdsh plugin hub: a Settings tab that installs, disables and configures omdsh plugins from a configurable upstream, from the settings schema each already registers",
  "version": "0.2.3",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-plugins/omdsh-plughub.git"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./contract": {
      "types": "./lib/types/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "omdsh-plughub": "./lib/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "plughub": {
      "displayName": {
        "": "Plugin Hub",
        "zh": "插件中心"
      },
      "summary": {
        "": "Install, disable, and configure omdsh plugins from inside Settings.",
        "zh": "在设置里安装、停用并配置 omdsh 插件。"
      },
      "category": "system",
      "settings": [
        "omdsh-plughub"
      ],
      "docs": "https://github.com/omdsh-plugins/omdsh-plughub#readme",
      "order": 0
    }
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.css",
    "scripts/**/*.ts",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json && tsdown",
    "typecheck": "tsc --build tsconfig.json --force && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "harness:local": "tsx scripts/harness-source.ts --local",
    "harness:npm": "tsx scripts/harness-source.ts --npm",
    "check:harness-pin": "tsx scripts/harness-source.ts --check",
    "prepare": "tsc --build tsconfig.json && tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-schema-form": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.7",
    "@deepseek-ai/schemastery": ">=0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-schema-form": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-web-react": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^26.0.0",
    "lightningcss": "^1.30.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
